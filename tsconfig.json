{
    "include": [
        "./src/**/*.ts",
        "./test/**/*.ts",
        "test/test.tsx"
    ],
    "exclude": [
        "./dist/**/*",
        "./externals/**/*",
        "./src/**/*.js",
        "./src/**/*.jsx"
    ],
    "compilerOptions": {
        "rootDir": "../",
        "outDir": "./dist/",
        "paths": {
            "@phosphor-icons/core/assets/*": [
                "./node_modules/@phosphor-icons/core/assets/*"
            ],
            "fonts/*": [
                "../../shared/assets/fonts/*"
            ],
            "@fest-lib/cdnImport": [
                "../../cdnImport.mjs"
            ],
            "@fest-lib/style-lib": [
                "../style.ts/src/index.ts"
            ],
            "@fest-lib/dom": [
                "../dom.ts/src/index.ts"
            ],
            "@fest-lib/lure": [
                "../lur.e/src/index.ts"
            ],
            "@fest-lib/lure/src/lure/node": [
                "./src/lure/node"
            ],
            "@fest-lib/lure/src/lure/node/*": [
                "./src/lure/node/*"
            ],
            "@fest-lib/object": [
                "../object.ts/src/index.ts"
            ],
            "@fest-lib/fl-ui": [
                "../fl.ui/src/index.ts"
            ],
            "@fest-lib/ui": [
                "../fl.ui/src/index.ts"
            ],
            "@fest-lib/uniform": [
                "../uniform.ts/src/index.ts"
            ],
            "@fest-lib/theme": [
                "../theme.core/src/index.ts"
            ],
            "@fest-lib/core": [
                "../core.ts/src/index.ts"
            ],
            "@fest-lib/polyfill/*": [
                "../../subsystem/fest/polyfill/*"
            ],
            "@fest-lib/*": [
                "../../subsystem/fest/*"
            ],
            "polyfill/*": [
                "../../subsystem/fest/polyfill/*"
            ]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker"
        ],
        "jsx": "preserve",
        "jsxImportSource": "@fest-lib/lure/src/lure/node",
        "jsxFactory": "createElement",
        "jsxFragmentFactory": "Fragment",
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "noImplicitThis": false,
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "inlineSourceMap": true,
        "typeRoots": [
            "plugins/global.d.ts"
        ],
        "experimentalDecorators": true,
        "noEmit": true,
        "noEmitOnError": true,
        "noEmitHelpers": true
    },
    "compileOnSave": false
}
