{
    "name": "@fest-lib/lure",
    "description": "fest-lib LUR.E: reactive DOM (E/H/M/Q), form bind, overlays, drag",
    "version": "0.1.52",
    "license": "MIT",
    "type": "module",
    "sideEffects": true,
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fest-live/lur.e.git"
    },
    "bugs": {
        "url": "https://github.com/fest-live/lur.e/issues"
    },
    "homepage": "https://github.com/fest-live/lur.e#readme",
    "keywords": [
        "fest",
        "fest-lib",
        "reactive",
        "dom",
        "ui",
        "typescript"
    ],
    "files": [
        "dist",
        "LICENSE"
    ],
    "main": "./dist/lure.js",
    "module": "./dist/lure.js",
    "exports": {
        ".": {
            "import": "./dist/lure.js",
            "default": "./dist/lure.js"
        },
        "./package.json": "./package.json",
        "./dist/index.js": "./dist/lure.js",
        "./index.js": "./dist/lure.js",
        "./src/lure/node/jsx-runtime": "./src/lure/node/jsx-runtime/index.ts",
        "./src/lure/node/jsx-dev-runtime": "./src/lure/node/jsx-dev-runtime/index.ts",
        "./markdown-assets": "./src/utils/opfs/markdown-assets.ts"
    },
    "dependencies": {
        "@fest-lib/core": ">=0.1.0",
        "@fest-lib/dom": ">=0.1.0",
        "@fest-lib/object": ">=0.1.0",
        "@fest-lib/style-lib": ">=0.1.0",
        "@fest-lib/uniform": ">=0.1.0"
    },
    "peerDependencies": {
        "@fest-lib/core": ">=0.1.0",
        "@fest-lib/dom": ">=0.1.0",
        "@fest-lib/object": ">=0.1.0",
        "@fest-lib/style-lib": ">=0.1.0",
        "@fest-lib/uniform": ">=0.1.0"
    },
    "scripts": {
        "test": "npm run test:linker && npm run test:interaction && npm run test:placement && npm run test:overlay-host && npm run test:trigger-core && npm run test:form-binding",
        "test:linker": "node ./scripts/run-linker-tests.mjs",
        "test:interaction": "node ./scripts/run-interaction-tests.mjs",
        "test:placement": "node ./scripts/run-placement-tests.mjs",
        "test:overlay-host": "node ./scripts/run-overlay-host-tests.mjs",
        "test:trigger-core": "node ./scripts/run-trigger-core-tests.mjs",
        "test:form-binding": "node ./scripts/run-form-binding-tests.mjs",
        "test:mapped": "node ./scripts/run-mapped-tests.mjs",
        "test:opfs-content-store": "node ./scripts/run-opfs-content-store-tests.mjs",
        "test:dev": "npm run demo",
        "dev": "npm run demo",
        "demo": "vite --host 0.0.0.0",
        "watch": "vite build --watch",
        "build": "vite build --config vite.config.js && npm run docs && npm run docs:md",
        "build:publish": "FEST_NPM_IMPORTS=1 vite build --config vite.config.js",
        "prepack": "npm run build:publish",
        "preview": "vite preview",
        "release": "PUPPETEER_SKIP_DOWNLOAD=1 npm run build:publish && npm publish --access public --ignore-scripts",
        "publish": "node ../scripts/bump-patch-version.mjs && npm run release",
        "docs": "typedoc ./src/index.ts --options ./typedoc.json --out ./docs --tsconfig ./tsconfig.json --excludeExternals --excludePrivate --excludeProtected --skipErrorChecking",
        "docs:clean": "rm -rf ./docs && typedoc --options ./typedoc.json",
        "docs:md": "typedoc --options ./typedoc.md.json",
        "docs:md:clean": "rm -rf ./docs-md && typedoc --options ./typedoc.md.json"
    },
    "devDependencies": {
        "@gerrit0/mini-shiki": "^3.23.0",
        "@praha/vite-plugin-external": ">=1.1.1",
        "@types/node": ">=22.8.1",
        "@vitejs/plugin-react": "^6.0.5",
        "cbor-x": ">=1.6.0",
        "linkify-it": "^5.0.2",
        "lunr": "^2.3.9",
        "markdown-it": "^14.3.0",
        "mdurl": "^2.1.0",
        "punycode.js": "^2.3.1",
        "tsconfig": "^7.0.0",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.12.0",
        "typescript": ">=6.0.0-beta",
        "uc.micro": "^2.1.0",
        "vite": "^8.0.7",
        "vite-plugin-external": ">=6.2.2",
        "vite-plugin-optimizer": ">=1.4.3",
        "yaml": "^2.9.0"
    }
}
